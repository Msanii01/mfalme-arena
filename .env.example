# ─────────────────────────────────────────────────────────────
# MFALME THE ARENA — Environment Variables Template
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mfalme_arena

# Base Network
BASE_NETWORK=sepolia
BASE_RPC_URL=https://sepolia.base.org
CHAIN_ID=84532

# Privy
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Contracts (populate after deployment in Phase 2)
PAYMASTER_ADDRESS=
ESCROW_CONTRACT_ADDRESS=
TOURNAMENT_CONTRACT_ADDRESS=
USDC_CONTRACT_ADDRESS=
ENTRY_POINT_ADDRESS=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789

# Deployer wallet (private key — NEVER commit, only in .env)
DEPLOYER_PRIVATE_KEY=

# Oracle wallet — signs on-chain settlements (settle/cancel) from the backend.
# Required in production. Must NOT be the deployer key. The backend will throw
# at boot if NODE_ENV=production and this is missing.
ORACLE_PRIVATE_KEY=

# Riot API
RIOT_API_KEY=
RIOT_REGION_CLUSTER=americas
RIOT_PROVIDER_ID=
RIOT_TOURNAMENT_ID=
RIOT_CALLBACK_URL=https://api.mfalme.xyz/webhooks/riot/result

# ERC-4337 / Bundler
BUNDLER_RPC_URL=

# App
JWT_SECRET=
PLATFORM_FEE_PERCENT=5
ADMIN_PRIVY_USER_ID=
ADMIN_WALLET_ADDRESS=
# Shared secret required by POST /webhooks/riot (X-Internal-Auth header).
# Leave blank in any environment where the route should be disabled outright.
WEBHOOK_SECRET=

# Backend
PORT=3001
NODE_ENV=development

# Frontend (prefixed with VITE_ for Vite to expose to client)
VITE_PRIVY_APP_ID=
VITE_API_URL=http://localhost:3001
